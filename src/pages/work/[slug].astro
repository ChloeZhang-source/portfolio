---
import { getCollection, render } from 'astro:content';
import CaseBar from '../../components/CaseBar.astro';
import CaseHero from '../../components/CaseHero.astro';
import Header from '../../components/Header.astro';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteOgImageUrl, buildCaseJsonLd } from '../../lib/seo';
import { workCaseHref } from '../../lib/work';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry, works },
	}));
}

const { entry, works } = Astro.props;
const work = entry.data;
const { Content } = await render(entry);

const caseOgImages = {
	speaking: '/og-speaking.jpg',
	interview: '/og-interview.jpg',
} as const;

const caseTitles = {
	speaking: 'AI 口语陪练：打开即用，无需注册｜张晓雪作品',
	interview: '标准化可复评面试系统：50+ 场真实招聘｜张晓雪作品',
} as const;

const caseJsonLdMeta = {
	speaking: {
		name: 'AI 口语陪练',
		description:
			'口语练习的最大阻碍是过高的启动成本。剥离前置流程与账号体系，实现打开即用、无需注册、一轮即成。公开内测累计 100+ 轮真实对话训练。',
	},
	interview: {
		name: '标准化可复评面试系统',
		description:
			'传统面试依赖个人经验，标准不可见、过程不可溯、结果不可评。将口头经验结构化为可录制、可打分、可复评、可复盘的体系。已落地 50+ 场真实教师招聘面试。',
	},
} as const;

const ogImage =
	work.slug in caseOgImages
		? caseOgImages[work.slug as keyof typeof caseOgImages]
		: site.ogImage;

const title =
	work.slug in caseTitles
		? caseTitles[work.slug as keyof typeof caseTitles]
		: `${site.name} · ${work.title}`;

const structured =
	work.slug in caseJsonLdMeta
		? caseJsonLdMeta[work.slug as keyof typeof caseJsonLdMeta]
		: { name: work.title, description: work.tagline };

const jsonLd = buildCaseJsonLd({
	name: structured.name,
	description: structured.description,
	url: absoluteOgImageUrl(Astro.site, workCaseHref(work.slug)),
});
---

<BaseLayout
	title={title}
	description={work.description}
	ogImage={ogImage}
	ogImageAlt={work.title}
	jsonLd={jsonLd}
>
	<Header slot="header" />
	<CaseHero work={work} />
	<article class="case-body">
		<Content />
	</article>
	<CaseBar slot="footer" work={work} works={works.map((item) => item.data)} />
</BaseLayout>

<style>
	.case-body {
		max-width: 42rem;
		padding: 0 1.25rem 2.5rem;
	}

	.case-body :global(h2) {
		margin: 1.75rem 0 0.75rem;
		font-size: 1.25rem;
		font-weight: 500;
	}

	.case-body :global(p),
	.case-body :global(ol) {
		margin: 0 0 0.85rem;
	}

	.case-body :global(a) {
		color: var(--color-accent);
	}
</style>
