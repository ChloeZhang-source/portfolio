---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import { absoluteOgImageUrl, resolveDocumentTitle } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	jsonLd?: Record<string, unknown>;
}

const {
	title: titleProp,
	description = site.metaDescription,
	ogImage = site.ogImage,
	ogImageAlt = site.headlineRole,
	jsonLd,
} = Astro.props;

const title = resolveDocumentTitle(titleProp, site.documentTitle);
const ogTitle = title;
const ogDescription = description;
const titleFontHref = withBase('/fonts/noto-serif-sc-title.woff2');
const faviconHref = withBase('/favicon.svg');
const canonicalHref = Astro.url.href;
const ogImageAbsolute = absoluteOgImageUrl(Astro.site, withBase(ogImage));
const ogImageWidth = '1200';
const ogImageHeight = '630';
const fontFaceCss = `/* Noto Serif SC Medium subset (SIL OFL 1.1), glyphs for page headings */
			@font-face {
				font-family: "Noto Serif SC";
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url("${titleFontHref}") format("woff2");
				unicode-range: U+20, U+2B, U+30, U+31, U+35, U+3001, U+3002, U+4E00, U+4E0D, U+4E0E, U+4E13, U+4E2D, U+4E48, U+4E60, U+4E86, U+4EA7, U+4EC0, U+4EE3, U+4F53, U+505A, U+50CF, U+5148, U+5168, U+516C, U+5185, U+518C, U+518D, U+51B3, U+51C6, U+5206, U+5207, U+5219, U+5224, U+5230, U+5236, U+52A8, U+5316, U+5373, U+539F, U+53D6, U+53E3, U+53EF, U+542F, U+54C1, U+56DB, U+5728, U+573A, U+590D, U+591A, U+5927, U+5B58, U+5B8C, U+5B9E, U+5BF9, U+5C5E, U+5E08, U+5EFA, U+5F00, U+5F03, U+5F55, U+600E, U+6210, U+6211, U+6237, U+6253, U+627E, U+62C6, U+62DB, U+6362, U+636E, U+642D, U+653E, U+6548, U+6559, U+6570, U+65AD, U+65E0, U+662F, U+6700, U+672A, U+672C, U+6784, U+679C, U+67B6, U+6807, U+6838, U+6863, U+69DB, U+6CE8, U+6D4B, U+6EAF, U+7387, U+73AF, U+73B0, U+7528, U+753B, U+7559, U+7684, U+76D8, U+771F, U+788D, U+7A0B, U+7B56, U+7CFB, U+7EC3, U+7ED3, U+7EDF, U+7F8E, U+8003, U+8058, U+820D, U+82F1, U+8303, U+89C1, U+89C4, U+8BC4, U+8BD5, U+8BDD, U+8BED, U+8F6E, U+8FC7, U+8FED, U+91CD, U+95E8, U+95ED, U+95EE, U+963B, U+9664, U+966A, U+9700, U+9762, U+9875, U+9879, U+9898, U+FF0C, U+FF1A, U+FF5C;
			}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="theme-color" content="#F4F3EF" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="张晓雪 · 作品集" />
		<meta property="og:locale" content="zh_CN" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageAbsolute} />
		<link rel="canonical" href={canonicalHref} />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
		<link
			rel="preload"
			href={titleFontHref}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<Fragment set:html={`<style>${fontFaceCss}</style>`} />
		{
			jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null
		}
	</head>
	<body>
		<a class="skip-link" href="#main">跳到正文</a>
		<header>
			<slot name="header" />
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<footer>
			<slot name="footer" />
		</footer>
	</body>
</html>
