---
import { homeCopy } from '../data/home';
import { site } from '../data/site';
import { heroMarginNotes } from '../lib/marginalia';
import { workCaseHref } from '../lib/work';
import { workImageSize } from '../lib/work-image';
import { withBase } from '../lib/paths';
import Annotation from './Annotation.astro';
import WindowBar from './WindowBar.astro';

interface Props {
	works: {
		slug: string;
		title: string;
		cover: string;
	}[];
}

const { works } = Astro.props;
---

<section id="home" class="chapter hero">
	<p class="running-head" aria-hidden="true">作品集 · {site.name}</p>
	<div class="hero__head">
		<div class="hero__lede">
			<p class="chapter__kicker">
				{
					homeCopy.heroKicker.split(/(\d[\d.-]*)/).map((part) =>
						/^\d/.test(part) ? <span class="num">{part}</span> : part,
					)
				}
			</p>
			<h1 class="hero__role misprint" data-text={site.headlineRole}>{site.headlineRole}</h1>
			<p class="hero__sub">
				{site.headlineSub.slice(0, site.headlineSub.indexOf('AI'))}<span class="lat">AI</span>{site.headlineSub.slice(site.headlineSub.indexOf('AI') + 2)}
			</p>
		</div>
		<div class="hero__notes">
			{
				heroMarginNotes(site.judgments).map((note) => (
					<Annotation tag={note.what} text={note.cost} />
				))
			}
		</div>
	</div>
	<div class="hero__board">
		{
			works.map((work, index) => (
				<article class={index === 0 ? 'hero__pair hero__pair--start' : 'hero__pair hero__pair--end'}>
					<a class="window" href={workCaseHref(work.slug)}>
						<WindowBar caption={work.title} />
						<div class={work.slug === 'interview' ? 'window__screen window__screen--mat' : 'window__screen'}>
							<img
								src={withBase(work.cover)}
								alt={work.title}
								width={workImageSize(work.cover).width}
								height={workImageSize(work.cover).height}
								decoding="async"
							/>
						</div>
					</a>
					<div class="hero__copy">
						<a class="hero__work-title" href={workCaseHref(work.slug)}>{work.title} →</a>
						<p class="hero__work-tagline">
							{homeCopy.heroPreviews[work.slug as keyof typeof homeCopy.heroPreviews]}
						</p>
					</div>
					<div class="hero__mark" aria-hidden="true">
						<span class="hero__mark-folio">{String(index + 1).padStart(2, '0')}</span>
						<span class="hero__mark-rule"></span>
						<span class="hero__mark-dot"></span>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.hero {
		position: relative;
	}

	.hero__head {
		display: grid;
		gap: 1.4rem;
		width: 100%;
	}

	.hero__notes {
		display: grid;
		gap: 1.4rem;
		align-content: start;
	}

	.chapter__kicker {
		letter-spacing: 0.04em;
		text-transform: none;
	}

	.hero h1 {
		margin: 0;
		max-width: 28rem;
		font-size: var(--text-display-1);
		font-weight: 500;
		line-height: var(--leading-display-1);
		letter-spacing: var(--tracking-display-1);
		text-wrap: balance;
		text-align: left;
	}

	.hero__role {
		font-family: var(--font-serif);
		letter-spacing: var(--tracking-display-1);
	}

	.hero__sub {
		margin: 0.55em 0 2.5rem;
		max-width: var(--measure);
		font-family: var(--font-sans);
		font-size: var(--text-lead);
		font-weight: 400;
		letter-spacing: var(--tracking-lead);
		line-height: var(--leading-lead);
		color: var(--color-muted);
		word-break: keep-all;
	}

	.hero__board {
		display: grid;
		gap: 1.6rem;
		width: min(var(--window-max), 100%);
	}

	.hero__pair {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.7fr) minmax(0, 0.95fr);
		grid-template-areas: "window copy mark";
		align-items: center;
		gap: 0.9rem 1.15rem;
		width: 100%;
	}

	.hero__pair--start {
		justify-self: stretch;
	}

	.hero__pair--end {
		grid-template-areas: "mark copy window";
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.7fr) minmax(0, 1.15fr);
		justify-self: stretch;
	}

	.hero__pair .window {
		grid-area: window;
		display: block;
		width: 100%;
		max-width: none;
		text-decoration: none;
		color: inherit;
	}

	.hero__copy {
		grid-area: copy;
		min-width: 0;
		text-align: left;
	}

	.hero__pair--end .hero__copy {
		text-align: right;
	}

	.hero__mark {
		grid-area: mark;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
		pointer-events: none;
	}

	.hero__pair--start .hero__mark,
	.hero__pair--end .hero__mark {
		justify-content: center;
	}

	.hero__pair--end .hero__mark {
		flex-direction: row-reverse;
	}

	.hero__mark-folio {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: var(--color-muted);
	}

	.hero__mark-rule {
		width: 2.5rem;
		height: 1px;
		background: var(--color-rule);
	}

	.hero__mark-dot {
		flex: 0 0 auto;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-amber-ink);
	}

	.hero__work-title,
	.hero__work-tagline {
		margin: 0;
	}

	.hero__work-title {
		color: inherit;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.5;
		text-decoration: none;
	}

	.hero__work-title:hover,
	.hero__work-title:focus-visible,
	.hero__pair:has(.window:hover) .hero__work-title,
	.hero__pair:has(.window:focus-visible) .hero__work-title {
		color: var(--color-accent);
	}

	.hero__work-tagline {
		margin-top: 0.3rem;
		color: var(--color-muted);
		font-size: 0.86rem;
		letter-spacing: 0.04em;
		line-height: 1.65;
	}

	@media (min-width: 900px) {
		.hero__head {
			grid-template-columns: minmax(0, var(--measure)) minmax(10rem, 1fr);
			gap: 1.5rem 2rem;
			align-items: start;
		}

		.hero__notes {
			padding-top: 2.6rem;
		}
	}

	@media (max-width: 899px) {
		.hero__pair,
		.hero__pair--start,
		.hero__pair--end {
			grid-template-columns: 1fr;
			grid-template-areas: "copy" "window";
			justify-self: stretch;
			width: 100%;
			justify-items: start;
		}

		.hero__copy,
		.hero__pair--end .hero__copy {
			text-align: left;
		}

		.hero__pair .window {
			width: 100%;
		}

		.hero__mark {
			display: none;
		}
	}

	@media (max-width: 639px) {
		.hero__pair .window {
			width: min(22rem, 100%);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__pair .window {
			animation: hero-window-in 380ms ease-out backwards;
		}

		.hero__pair--end .window {
			animation-delay: 90ms;
		}
	}

	@media (min-width: 1100px) {
		.hero {
			padding-top: 4rem;
		}

		.hero__sub {
			margin-bottom: 1.25rem;
		}

		.hero .window__screen {
			max-height: 16rem;
		}
	}

	@keyframes hero-window-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
