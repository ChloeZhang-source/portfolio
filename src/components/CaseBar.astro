---
import type { Work } from '../content/works-schema';
import { caseCopy } from '../data/case';
import { site } from '../data/site';
import { mailtoHref } from '../lib/contact';
import { otherCaseWork, workCaseHref } from '../lib/work';
import { withBase } from '../lib/paths';

interface Props {
	work: Work;
	works: Work[];
}

const { work, works } = Astro.props;
const other = otherCaseWork(works, work.slug);
---

<div class="case-bar">
	{
		other && (
			<p>
				<a class="btn" href={workCaseHref(other.slug)}>{caseCopy.otherWorkPrefix}{other.title}</a>
			</p>
		)
	}
	<p>
		<a href={mailtoHref(site.email)}>{caseCopy.mailLabel}</a>
	</p>
	<p>
		<a href={withBase(caseCopy.wechatHref)}>{caseCopy.wechatSeeHome}</a>
	</p>
</div>

<style>
	.case-bar {
		display: grid;
		gap: 0.75rem;
		padding: 1.5rem 1.25rem 2rem;
		border-top: 1px solid var(--c-hairline);
	}

	.case-bar p {
		margin: 0;
	}

	.case-bar a:not(.btn) {
		color: var(--color-muted);
	}
</style>
