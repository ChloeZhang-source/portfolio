---
import { homeCopy } from '../data/home';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<section class="about">
	<h2>{homeCopy.aboutTitle}</h2>
	<p>{site.about}</p>
	<p class="about__resume">
		<a href={withBase(site.resumeHref)} download={site.resumeDownloadName}>{site.resumeLabel}</a>
	</p>
</section>

<style>
	.about {
		scroll-margin-top: 4.5rem;
	}

	.about h2 {
		margin: 0 0 0.85rem;
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.about p {
		margin: 0 0 1rem;
		max-width: 40rem;
		color: var(--color-muted);
	}

	.about__resume {
		margin: 0;
	}

	.about__resume a {
		color: var(--color-muted);
		font-size: var(--font-size-muted);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.about__resume a:hover {
		color: var(--color-text);
	}
</style>
