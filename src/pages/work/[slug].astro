---
import { getCollection, render } from 'astro:content';
import CaseBar from '../../components/CaseBar.astro';
import CaseHero from '../../components/CaseHero.astro';
import Header from '../../components/Header.astro';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteOgImageUrl, buildCaseJsonLd } from '../../lib/seo';
import { workCaseHref } from '../../lib/work';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry, works },
	}));
}

const { entry, works } = Astro.props;
const work = entry.data;
const { Content } = await render(entry);

const caseOgImages = {
	speaking: '/og-speaking.jpg',
	interview: '/og-interview.jpg',
} as const;

const caseTitles = {
	speaking: 'AI 口语陪练：打开就能练完一轮｜张晓雪作品',
	interview: '教师招聘面试系统：50+ 场可复评流程｜张晓雪作品',
} as const;

const caseJsonLdMeta = {
	speaking: {
		name: 'AI 口语陪练',
		description: '练口语卡在开口之前——所以我拆了注册墙，让第一轮先成立。',
	},
	interview: {
		name: '教师招聘面试系统',
		description: '口口相传的标准没法复评——所以我把它做成了一轮可以打分的工作流。',
	},
} as const;

const ogImage =
	work.slug in caseOgImages
		? caseOgImages[work.slug as keyof typeof caseOgImages]
		: site.ogImage;

const title =
	work.slug in caseTitles
		? caseTitles[work.slug as keyof typeof caseTitles]
		: `${site.name} · ${work.title}`;

const structured =
	work.slug in caseJsonLdMeta
		? caseJsonLdMeta[work.slug as keyof typeof caseJsonLdMeta]
		: { name: work.title, description: work.tagline };

const jsonLd = buildCaseJsonLd({
	name: structured.name,
	description: structured.description,
	url: absoluteOgImageUrl(Astro.site, workCaseHref(work.slug)),
});
---

<BaseLayout
	title={title}
	description={work.description}
	ogImage={ogImage}
	ogImageAlt={work.title}
	jsonLd={jsonLd}
>
	<Header slot="header" />
	<CaseHero work={work} />
	<article class="case-body">
		<Content />
	</article>
	<CaseBar slot="footer" work={work} works={works.map((item) => item.data)} />
</BaseLayout>

<style>
	.case-body {
		max-width: 42rem;
		padding: 0 1.25rem 2.5rem;
	}

	.case-body :global(h2) {
		margin: 1.75rem 0 0.75rem;
		font-size: 1.25rem;
		font-weight: 500;
	}

	.case-body :global(p),
	.case-body :global(ol) {
		margin: 0 0 0.85rem;
	}

	.case-body :global(a) {
		color: var(--color-accent);
	}
</style>
