---
import { homeCopy } from '../data/home';
import { site } from '../data/site';
import { splitExperiencePeriod } from '../lib/experience';
import WindowBar from './WindowBar.astro';
---

<section class="experience">
	<h2>{homeCopy.experienceTitle}</h2>
	<div class="window">
		<WindowBar caption="经历" />
		<div class="window--notes experience__notes">
			<ol class="experience__rail">
				{
					site.experience.map((item) => {
						const when = splitExperiencePeriod(item.period);
						return (
							<li class:list={['experience__entry', when.current && 'experience__entry--now']}>
								<p class="experience__when">
									<b>{when.start}</b>{' '}{when.end}
								</p>
								<h3>{item.org}</h3>
								<p class="experience__role">{item.role}</p>
								<ul class="experience__points">
									{item.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							</li>
						);
					})
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.experience {
		--exp-ink: #1c1c1c;
		--exp-ink-2: #5a574f;
		--exp-ink-3: #8a857a;
		--exp-rail: rgba(27, 26, 23, 0.15);
		--exp-node: rgba(27, 26, 23, 0.3);
		--rail-pad: 136px;
		--rail-x: 110px;
	}

	.experience :global(.window) {
		width: 100%;
	}

	.experience__notes {
		padding: 1.15rem 1.1rem 1.35rem 0.85rem;
	}

	.experience h2 {
		margin: 0 0 1.5em;
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--exp-ink);
	}

	.experience__rail {
		position: relative;
		margin: 0;
		padding: 0 0 0 var(--rail-pad);
		list-style: none;
	}

	.experience__rail::before {
		content: '';
		position: absolute;
		top: 12px;
		bottom: 14px;
		left: var(--rail-x);
		width: 1px;
		background: var(--exp-rail);
	}

	.experience__entry {
		position: relative;
		margin: 0 0 2.5em;
	}

	.experience__entry:last-child {
		margin-bottom: 0;
	}

	.experience__entry::before {
		content: '';
		position: absolute;
		top: 9.5px;
		left: calc(var(--rail-x) - var(--rail-pad) - 4px);
		width: 8px;
		height: 8px;
		border: 1.5px solid var(--exp-node);
		border-radius: 50%;
		background: var(--color-surface);
	}

	.experience__entry--now::before {
		top: 8.5px;
		left: calc(var(--rail-x) - var(--rail-pad) - 5.5px);
		width: 11px;
		height: 11px;
		border: 0;
		background: var(--color-amber);
	}

	.experience__when {
		position: absolute;
		top: 1px;
		left: calc(var(--rail-pad) * -1);
		width: 98px;
		margin: 0;
		color: var(--exp-ink-3);
		font-family: var(--font-mono);
		font-size: 0.775em;
		font-variant-numeric: tabular-nums;
		line-height: 1.5;
		text-align: right;
	}

	.experience__when b {
		display: block;
		color: #3a3833;
		font-weight: 500;
	}

	.experience h3 {
		margin: 0;
		font-size: 1.28em;
		font-weight: 500;
		line-height: 1.35;
		color: var(--exp-ink);
	}

	.experience__role {
		margin: 0.32em 0 1em;
		color: var(--exp-ink-3);
		font-size: 0.92em;
	}

	.experience__points {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.experience__points li {
		position: relative;
		margin: 0 0 0.7em;
		padding-left: 1.4em;
		color: var(--exp-ink-2);
		font-size: 0.95em;
		line-height: 1.76;
	}

	.experience__points li:last-child {
		margin-bottom: 0;
	}

	.experience__points li::before {
		content: '';
		position: absolute;
		top: 0.72em;
		left: 0.1em;
		width: 11px;
		height: 1px;
		background: rgba(27, 26, 23, 0.34);
	}

	@media (max-width: 44.9rem) {
		.experience {
			--rail-pad: 1.15rem;
			--rail-x: 0.28rem;
		}

		.experience__notes {
			padding: 1rem 0.95rem 1.2rem 0.7rem;
		}

		.experience__when {
			position: static;
			width: auto;
			margin: 0 0 0.45em;
			text-align: left;
		}

		.experience__when b {
			display: inline;
			margin-right: 0.35em;
		}

		.experience__entry::before,
		.experience__entry--now::before {
			top: 0.45em;
		}
	}
</style>
