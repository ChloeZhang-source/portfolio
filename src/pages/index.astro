---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ChapterRule from '../components/ChapterRule.astro';
import SideAtmosphere from '../components/SideAtmosphere.astro';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
	<Header slot="header" />
	<SideAtmosphere />
	<Hero works={works.map((entry) => entry.data)} />
	<section id="work" class="chapter">
		<div class="chapter__art" aria-hidden="true">
			<ChapterRule />
		</div>
		<p class="chapter__kicker">作品</p>
		<div class="chapter__works">
			{
				works.map((entry) => (
					<WorkCard work={entry.data} />
				))
			}
		</div>
	</section>
	<section id="experience" class="chapter chapter--experience">
		<div class="chapter__art" aria-hidden="true">
			<ChapterRule />
		</div>
		<p class="chapter__kicker">经历</p>
		<About />
		<Experience />
		<Contact />
	</section>
	<Footer slot="footer" />
</BaseLayout>

<style>
	.chapter__works {
		width: min(var(--window-max), 100%);
		display: grid;
		gap: 3.5rem;
	}

	.chapter--experience {
		scroll-margin-top: 6rem;
	}

	.chapter--experience :global(.about),
	.chapter--experience :global(.experience),
	.chapter--experience :global(.contact) {
		width: min(var(--window-max), 100%);
		padding: 1.25rem 0;
		text-align: left;
	}

	.chapter--experience :global(.about h2),
	.chapter--experience :global(.experience h2),
	.chapter--experience :global(.contact h2) {
		max-width: none;
		text-align: left;
	}
</style>
