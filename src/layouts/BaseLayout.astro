---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import { absoluteOgImageUrl, resolveDocumentTitle } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
}

const {
	title: titleProp,
	description = site.headline,
	ogImage = site.ogImage,
	ogImageAlt = site.headlineRole,
} = Astro.props;

const title = resolveDocumentTitle(titleProp, site.name);
const ogTitle = title;
const ogDescription = description;
const titleFontHref = withBase('/fonts/noto-serif-sc-title.woff2');
const faviconHref = withBase('/favicon.svg');
const canonicalHref = Astro.url.href;
const ogImageAbsolute = absoluteOgImageUrl(Astro.site, withBase(ogImage));
const ogImageWidth = '1200';
const ogImageHeight = '630';
const fontFaceCss = `/* Noto Serif SC Medium subset (SIL OFL 1.1), glyphs for page headings */
			@font-face {
				font-family: "Noto Serif SC";
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url("${titleFontHref}") format("woff2");
				unicode-range: U+20, U+41, U+49, U+3002, U+4E00, U+4E0D, U+4E0E, U+4E24, U+4E2A, U+4E2D, U+4E48, U+4E86, U+4E8E, U+4EA7, U+4EBA, U+4EC0, U+4EE3, U+4F5C, U+505A, U+5173, U+5199, U+51E0, U+5224, U+5230, U+53CD, U+53E3, U+540C, U+54C1, U+5728, U+5B8C, U+5BDF, U+601D, U+6210, U+6211, U+627E, U+628A, U+63A8, U+6536, U+655B, U+6587, U+65AD, U+65B9, U+6709, U+672A, U+679C, U+6848, U+6D1E, U+6D41, U+73AF, U+73B0, U+751F, U+7528, U+7684, U+7801, U+79D1, U+7A0B, U+7CFB, U+7EC3, U+7ED3, U+7EDF, U+8054, U+80FD, U+8BD5, U+8BED, U+8D70, U+8F6E, U+8FC7, U+95ED, U+95EE, U+966A, U+9762, U+9875, U+9898, U+FF0C, U+FF1A;
			}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={canonicalHref} />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
		<link
			rel="preload"
			href={titleFontHref}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<Fragment set:html={`<style>${fontFaceCss}</style>`} />
	</head>
	<body>
		<a class="skip-link" href="#main">跳到正文</a>
		<header>
			<slot name="header" />
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<footer>
			<slot name="footer" />
		</footer>
	</body>
</html>
