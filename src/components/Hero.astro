---
import { homeCopy } from '../data/home';
import { site } from '../data/site';
import { heroMarginNotes } from '../lib/marginalia';
import { withBase } from '../lib/paths';
import Annotation from './Annotation.astro';
import SpeakingExhibit from './SpeakingExhibit.astro';
---

<section id="home" class="chapter hero">
	<p class="running-head" aria-hidden="true">作品集 · {site.name}</p>
	<div class="hero__frame">
		<div class="hero__lede">
			<p class="chapter__kicker hero__beat">
				{
					homeCopy.heroKicker.split(/(\d[\d.-]*)/).map((part) =>
						/^\d/.test(part) ? <span class="num">{part}</span> : part,
					)
				}
			</p>
			<h1 class="hero__role misprint hero__beat hero__beat--title" data-text={site.headlineRole}>{site.headlineRole}</h1>
			<div class="hero__arrive hero__beat hero__beat--arrive">
				<p class="hero__sub">
					{site.headlineSub.slice(0, site.headlineSub.indexOf('AI'))}<span class="lat">AI</span>{site.headlineSub.slice(site.headlineSub.indexOf('AI') + 2)}
				</p>
				<div class="hero__actions">
					<a class="btn" href={homeCopy.heroWorkHref}>看作品</a>
					<a class="btn-ghost" href={withBase(site.resumeHref)} download={site.resumeDownloadName}>{site.resumeLabel}</a>
				</div>
				<p class="hero__facts">
					<span>口语陪练：约 <span class="num">300</span> 人次体验（含重复访问）</span>
					<span>面试系统：教师招聘 <span class="num">50+</span> 场（单一企业）</span>
				</p>
			</div>
		</div>
		<div class="hero__exhibit hero__beat hero__beat--exhibit">
			<SpeakingExhibit />
		</div>
		<div class="hero__notes">
			{
				heroMarginNotes(site.judgments).map((note) => (
					<Annotation tag={note.what} text={note.cost} />
				))
			}
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
	}

	.hero__frame {
		display: grid;
		gap: 1.4rem;
		width: 100%;
	}

	.hero__lede,
	.hero__exhibit {
		min-width: 0;
	}

	.hero__notes {
		display: grid;
		gap: 1.4rem;
		align-content: start;
	}

	.chapter__kicker {
		letter-spacing: 0.04em;
		text-transform: none;
	}

	.hero h1 {
		margin: 0;
		max-width: 100%;
		font-size: clamp(3.25rem, 6.5vw, 5.25rem);
		font-weight: 500;
		line-height: var(--leading-display-1);
		letter-spacing: -0.02em;
		text-wrap: balance;
		text-align: left;
	}

	.hero__role {
		font-family: var(--font-serif);
		letter-spacing: -0.02em;
	}

	.hero__sub {
		margin: 0.55em 0 1.15rem;
		max-width: var(--measure);
		font-family: var(--font-sans);
		font-size: var(--text-lead);
		font-weight: 400;
		letter-spacing: var(--tracking-lead);
		line-height: var(--leading-lead);
		color: var(--color-muted);
		word-break: keep-all;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0.85rem 0 0;
		max-width: var(--measure);
		color: var(--color-body);
		font-size: var(--text-small);
		line-height: var(--leading-small);
		letter-spacing: var(--tracking-small);
	}

	@media (min-width: 900px) {
		.hero__frame {
			grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 1fr);
			gap: 1.5rem 2rem;
			align-items: start;
		}

		.hero__exhibit {
			grid-column: 2;
			grid-row: 1 / span 2;
		}

		.hero__notes {
			grid-column: 1;
		}
	}

	@media (max-width: 639px) {
		.hero__exhibit {
			width: min(22rem, 100%);
		}
	}

	@media (min-width: 1100px) {
		.hero {
			padding-top: 4rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__beat {
			animation: hero-rise var(--dur-3) var(--ease-out) backwards;
		}

		.hero__beat--title {
			animation-delay: 120ms;
			animation-timing-function: var(--ease-quart);
		}

		.hero__beat--arrive {
			animation-delay: 300ms;
		}

		.hero__beat--exhibit {
			animation-delay: 400ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__beat {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
