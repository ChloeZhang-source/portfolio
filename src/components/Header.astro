---
import { site } from '../data/site';
import { navCurrentHref } from '../lib/nav';
import { withBase } from '../lib/paths';

const currentHref = navCurrentHref(Astro.url.pathname, Astro.url.hash);
---

<div class="site-header">
	<a class="site-header__name" href={withBase('/')}>{site.name}</a>
	<nav class="site-header__nav" aria-label="页面导航">
		{
			site.nav.map((item) => (
				<a
					href={withBase(item.href)}
					class:list={[withBase(item.href) === currentHref && 'nav-current']}
					aria-current={withBase(item.href) === currentHref ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</div>

<script>
	import { navCurrentHref, navHrefForChapter } from '../lib/nav';
	import {
		SIDE_CHAPTERS,
		SIDE_CHAPTER_SELECTORS,
		pageScrolledToEnd,
		resolveScrolledChapter,
		type ChapterBounds,
	} from '../lib/side-atmosphere';

	const nav = document.querySelector('.site-header__nav');

	if (nav) {
		const links = [...nav.querySelectorAll('a')];

		const paint = (href: string) => {
			for (const link of links) {
				const on = link.getAttribute('href') === href;
				link.classList.toggle('nav-current', on);
				if (on) {
					link.setAttribute('aria-current', 'page');
				} else {
					link.removeAttribute('aria-current');
				}
			}
		};

		const fromLocation = () => {
			paint(navCurrentHref(location.pathname, location.hash));
		};

		const fromScroll = () => {
			const header = document.querySelector('body > header');
			const anchor = (header?.getBoundingClientRect().bottom ?? 72) + 8;
			const chapters: ChapterBounds[] = [];

			for (const id of SIDE_CHAPTERS) {
				const el = document.querySelector(SIDE_CHAPTER_SELECTORS[id]);
				if (!el) {
					continue;
				}

				const rect = el.getBoundingClientRect();
				chapters.push({ id, top: rect.top, bottom: rect.bottom });
			}

			if (chapters.length === 0) {
				fromLocation();
				return;
			}

			const contact = document.querySelector('#contact');
			const contactTop = contact ? contact.getBoundingClientRect().top : null;
			const atPageEnd = pageScrolledToEnd(
				window.scrollY,
				window.innerHeight,
				document.documentElement.scrollHeight,
			);
			paint(navHrefForChapter(resolveScrolledChapter(chapters, anchor, contactTop, atPageEnd)));
		};

		fromLocation();

		if (document.querySelector('#home')) {
			fromScroll();
			requestAnimationFrame(fromScroll);
			window.addEventListener('scroll', fromScroll, { passive: true });
			window.addEventListener('resize', fromScroll);
		}
	}
</script>

<style>
	.site-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem 1.25rem;
		padding: 0.85rem var(--page-pad);
	}

	.site-header__name {
		font-weight: 500;
		letter-spacing: var(--tracking-body);
		text-decoration: none;
	}

	.site-header__nav {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.6rem;
	}

	.site-header__nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.85rem 0.2rem;
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-small);
		line-height: var(--leading-control);
		transition: color var(--dur-1) var(--ease-out);
	}

	.site-header__nav a:hover,
	.site-header__nav a.nav-current {
		color: var(--color-text);
	}

	.site-header__nav a.nav-current::after {
		background: var(--color-amber-ink);
	}

	@media (min-width: 1100px) {
		.site-header {
			padding-inline: var(--page-pad-wide);
		}
	}

	@media (max-width: 639px) {
		.site-header {
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0.35rem 0.5rem;
			padding-block: 0.4rem;
		}

		.site-header__nav {
			grid-column: 2;
			flex-wrap: nowrap;
			justify-content: flex-end;
			gap: 0.25rem 0.55rem;
		}

		.site-header__nav a {
			font-size: var(--text-caption);
			padding-inline: 0.08rem;
		}
	}
</style>
