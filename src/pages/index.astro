---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SpeakingExhibit from '../components/SpeakingExhibit.astro';
import ChapterRail from '../components/ChapterRail.astro';
import SideAtmosphere from '../components/SideAtmosphere.astro';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeCopy } from '../data/home';
import { buildHomeJsonLd } from '../lib/seo';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = buildHomeJsonLd();
---

<BaseLayout jsonLd={jsonLd}>
	<Header slot="header" />
	<SideAtmosphere />
	<ChapterRail />
	<Hero />
	<section id="work" class="chapter">
		<p class="chapter__kicker">作品</p>
		<p class="chapter__thesis">{homeCopy.workThesis}</p>
		{
			homeCopy.workLede.map((paragraph) => (
				<p class="chapter__lede">{paragraph}</p>
			))
		}
		<p class="chapter__identity">{homeCopy.workIdentity}</p>
		<div class="chapter__case chapter__case--speaking">
			<div class="chapter__works">
				{
					works.filter((entry) => entry.data.slug === 'speaking').map((entry) => (
						<WorkCard work={entry.data}>
							<div slot="preview" class="chapter__exhibit">
								<SpeakingExhibit />
							</div>
						</WorkCard>
					))
				}
			</div>
		</div>
		<div class="chapter__case chapter__case--interview">
			<div class="chapter__works">
				{
					works.filter((entry) => entry.data.slug === 'interview').map((entry) => (
						<WorkCard work={entry.data} />
					))
				}
			</div>
		</div>
		<p class="chapter__closing">{homeCopy.workClosing}</p>
		<a class="chapter__about-link" href="#about">关于我 <span aria-hidden="true">→</span></a>
		<p class="folio">— <span class="num">01</span> —</p>
	</section>
	<section id="about" class="chapter chapter--about">
		<p class="chapter__kicker">关于</p>
		<About />
		<Contact />
		<p class="folio">— <span class="num">02</span> —</p>
	</section>
	<Footer slot="footer" />
</BaseLayout>

<style>
	.chapter__works {
		width: min(var(--window-max), 100%);
		display: grid;
		gap: 3.5rem;
	}

	.chapter__case + .chapter__case {
		margin-top: 3.5rem;
		padding-top: 3.5rem;
		border-top: 1px solid var(--c-hairline);
	}

	.chapter__closing {
		width: min(var(--window-max), 100%);
		margin: 4rem 0 0.75rem;
		color: var(--color-muted);
		line-height: var(--leading-body);
	}

	.chapter__about-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 44px;
		color: var(--color-text);
		font-size: var(--text-small);
		line-height: var(--leading-control);
		text-decoration-color: var(--c-hairline);
		text-underline-offset: 0.25em;
	}

	.chapter__about-link span {
		color: var(--color-muted);
	}

	.chapter__identity {
		width: min(var(--window-max), 100%);
		margin: -1.25rem 0 2.25rem;
		color: var(--color-muted);
		font-size: var(--text-caption);
		letter-spacing: var(--tracking-label);
	}

	.chapter__exhibit {
		width: 100%;
		margin: 0;
	}

	@media (max-width: 720px) {
		.chapter__case + .chapter__case {
			margin-top: 2.5rem;
			padding-top: 2.5rem;
		}
	}

	.chapter--about {
		scroll-margin-top: 6rem;
	}

	.chapter--about :global(.about) {
		width: 100%;
		padding: 1.25rem 0;
		text-align: left;
	}

	.chapter--about :global(.contact) {
		width: min(var(--window-max), 100%);
		padding: 1.25rem 0;
		text-align: left;
	}

	.chapter--about :global(.about h2) {
		max-width: none;
		text-align: left;
	}
</style>
