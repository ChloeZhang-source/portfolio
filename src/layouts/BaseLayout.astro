---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import { absoluteOgImageUrl, resolveDocumentTitle } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	jsonLd?: Record<string, unknown>;
}

const {
	title: titleProp,
	description = site.metaDescription,
	ogImage = site.ogImage,
	ogImageAlt = site.headlineRole,
	jsonLd,
} = Astro.props;

const title = resolveDocumentTitle(titleProp, site.documentTitle);
const ogTitle = title;
const ogDescription = description;
const titleFontHref = withBase('/fonts/noto-serif-sc-title.woff2');
const faviconHref = withBase('/favicon.svg');
const canonicalHref = Astro.url.href;
const ogImageAbsolute = absoluteOgImageUrl(Astro.site, withBase(ogImage));
const ogImageWidth = '1200';
const ogImageHeight = '630';
const fontFaceCss = `/* Noto Serif SC Medium subset (SIL OFL 1.1), glyphs for page headings */
			@font-face {
				font-family: "Noto Serif SC";
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url("${titleFontHref}") format("woff2");
				unicode-range: U+20, U+2B, U+30, U+35, U+41, U+49, U+3002, U+4E00, U+4E0B, U+4E0D, U+4E24, U+4E2A, U+4E2D, U+4E48, U+4E60, U+4E86, U+4E8B, U+4EA7, U+4EC0, U+4EE5, U+4EF6, U+4F5C, U+505A, U+5148, U+516C, U+5185, U+518C, U+5199, U+51C6, U+51E0, U+5206, U+5224, U+5230, U+52A8, U+5316, U+5361, U+53CA, U+53D8, U+53E3, U+53E5, U+53EF, U+53F0, U+540C, U+548C, U+54C1, U+56DB, U+5728, U+573A, U+5B50, U+5B66, U+5B8C, U+5B9E, U+5DF1, U+5E08, U+5F00, U+5F03, U+5F84, U+600E, U+60F3, U+6210, U+6211, U+6253, U+627E, U+628A, U+62DB, U+62FF, U+6389, U+6392, U+63A5, U+653E, U+65AD, U+672A, U+6765, U+679C, U+67E5, U+6807, U+68C0, U+699C, U+69DB, U+6B65, U+6CD5, U+6CE8, U+6D41, U+6D4B, U+6DF1, U+73AF, U+73B0, U+7684, U+76F4, U+771F, U+7A0B, U+7ACB, U+7B2C, U+7CFB, U+7EC3, U+7ED3, U+7ED9, U+7EDF, U+8001, U+8058, U+80FD, U+8111, U+81EA, U+8282, U+884C, U+88C5, U+8981, U+8BA9, U+8BBA, U+8BD5, U+8BED, U+8D44, U+8D70, U+8DD1, U+8DEF, U+8F6E, U+8FC7, U+90FD, U+91CC, U+95E8, U+95ED, U+95EE, U+966A, U+9762, U+9875, U+9898, U+FF0C, U+FF1A;
			}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="theme-color" content="#F4F3EF" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="张晓雪 · 作品集" />
		<meta property="og:locale" content="zh_CN" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageAbsolute} />
		<link rel="canonical" href={canonicalHref} />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
		<link
			rel="preload"
			href={titleFontHref}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<Fragment set:html={`<style>${fontFaceCss}</style>`} />
		{
			jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null
		}
	</head>
	<body>
		<a class="skip-link" href="#main">跳到正文</a>
		<header>
			<slot name="header" />
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<footer>
			<slot name="footer" />
		</footer>
	</body>
</html>
