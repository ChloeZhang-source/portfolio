---
import { site } from '../data/site';
import { navCurrentHref, navHrefForChapter } from '../lib/nav';
import { withBase } from '../lib/paths';

const currentHref = navCurrentHref(Astro.url.pathname, Astro.url.hash);
---

<nav class="rail" data-chapter-rail aria-label="章节">
	{
		site.nav.map((item) => {
			const href = withBase(item.href);
			const active = href === currentHref;
			return (
				<a
					href={href}
					data-active={active ? true : undefined}
					aria-current={active ? 'true' : undefined}
				>
					{item.label}
				</a>
			);
		})
	}
</nav>

<script>
	import { navHrefForChapter, type NavChapter } from '../lib/nav';
	import {
		SIDE_CHAPTERS,
		SIDE_CHAPTER_SELECTORS,
		pageScrolledToEnd,
		resolveScrolledChapter,
		type ChapterBounds,
	} from '../lib/side-atmosphere';

	const rail = document.querySelector<HTMLElement>('[data-chapter-rail]');

	if (rail && document.querySelector('#home')) {
		const links = [...rail.querySelectorAll('a')];

		const paint = (chapter: NavChapter) => {
			const href = navHrefForChapter(chapter);
			for (const link of links) {
				const on = link.getAttribute('href') === href;
				if (on) {
					link.setAttribute('data-active', '');
					link.setAttribute('aria-current', 'true');
				} else {
					link.removeAttribute('data-active');
					link.removeAttribute('aria-current');
				}
			}
		};

		const fromScroll = () => {
			const header = document.querySelector('body > header');
			const anchor = (header?.getBoundingClientRect().bottom ?? 72) + 8;
			const chapters: ChapterBounds[] = [];

			for (const id of SIDE_CHAPTERS) {
				const el = document.querySelector(SIDE_CHAPTER_SELECTORS[id]);
				if (!el) continue;

				const rect = el.getBoundingClientRect();
				chapters.push({ id, top: rect.top, bottom: rect.bottom });
			}

			if (chapters.length === 0) return;

			const contact = document.querySelector('#contact');
			const contactTop = contact ? contact.getBoundingClientRect().top : null;
			const atPageEnd = pageScrolledToEnd(
				window.scrollY,
				window.innerHeight,
				document.documentElement.scrollHeight,
			);
			paint(resolveScrolledChapter(chapters, anchor, contactTop, atPageEnd));
		};

		fromScroll();
		requestAnimationFrame(fromScroll);
		window.addEventListener('scroll', fromScroll, { passive: true });
		window.addEventListener('resize', fromScroll);
	}
</script>

<style>
	.rail {
		position: fixed;
		z-index: var(--z-rail);
		top: 50%;
		right: 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		width: auto !important;
		max-width: none !important;
		margin: 0 !important;
		transform: translateY(-50%);
		pointer-events: auto;
	}

	.rail a {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		min-height: 44px;
		padding-inline: 0.2rem;
		opacity: .55;
		color: var(--c-muted);
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 500;
		line-height: var(--leading-micro);
		letter-spacing: var(--tracking-micro);
		text-decoration: none;
		transition: opacity var(--dur-2) var(--ease-out);
	}

	.rail a::after {
		content: '';
		width: 18px;
		height: 1px;
		background: var(--c-rule);
		transition: width var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
	}

	.rail a[data-active] {
		opacity: 1;
		color: var(--c-ink);
	}

	.rail a[data-active]::after {
		width: 34px;
		background: var(--c-amber-ink);
	}

	@media (max-width: 1099px) {
		.rail {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.rail a,
		.rail a::after {
			transition: none;
		}
	}
</style>
