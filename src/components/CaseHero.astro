---
import type { Work } from '../content/works-schema';
import { caseCopy } from '../data/case';
import { caseProductCta, showCaseDemo } from '../lib/work';
import { workImageSize } from '../lib/work-image';
import { withBase } from '../lib/paths';
import WindowBar from './WindowBar.astro';

interface Props {
	work: Work;
}

const { work } = Astro.props;
const product = caseProductCta(work);
const demo = showCaseDemo(work);
const coverSize = workImageSize(work.cover);
const screenClass = work.slug === 'interview' ? 'window__screen window__screen--mat' : 'window__screen';
---

<section class="case-hero">
	<h1>{work.title}</h1>
	<p class="case-hero__tagline">{work.tagline}</p>
	<dl class="case-hero__summary" aria-label="项目摘要">
		{work.role && <div><dt>角色</dt><dd>{work.role}</dd></div>}
		{work.period && <div><dt>周期</dt><dd>{work.period}</dd></div>}
		<div class="case-hero__summary-result"><dt>结果</dt><dd>{work.result}</dd></div>
	</dl>
	<div class="window case-hero__media">
		<WindowBar caption={work.title} />
		<div class={screenClass}>
			{
				work.video ? (
					<video src={withBase(work.video)} poster={withBase(work.cover)} muted loop playsinline controls></video>
				) : (
					<img
						src={withBase(work.cover)}
						alt={work.title}
						width={coverSize.width}
						height={coverSize.height}
						decoding="async"
					/>
				)
			}
		</div>
	</div>
	<div class="case-hero__cta">
		{
			product.external ? (
				<a
					class="btn"
					href={product.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${product.label}（新窗口）`}
				>
					{product.label}
				</a>
			) : (
				<a class="btn" href={product.href}>
					{product.label}
				</a>
			)
		}
	</div>
	{
		demo && (
			<section id="demo" class="case-hero__demo">
				<p>{caseCopy.accessTitle}</p>
				<p>{work.demoNotes}</p>
				<div class="case-hero__cta">
					{
						product.external && (
							<a class="btn" href={caseCopy.walkthroughHref}>
								{caseCopy.walkthroughLabel}
							</a>
						)
					}
					<a class="case-hero__resume" href={withBase(caseCopy.requestHref)}>
						{caseCopy.requestLabel}
					</a>
				</div>
			</section>
		)
	}
</section>

<script>
	if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('.case-hero__media video')) {
			video.autoplay = true;
			void video.play();
		}
	}
</script>

<style>
	.case-hero {
		display: grid;
		gap: 1rem;
		padding: 2.25rem 1.25rem 2rem;
	}

	.case-hero h1 {
		margin: 0;
		max-width: 42rem;
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: 0.02em;
	}

	.case-hero__tagline {
		max-width: 42rem;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.case-hero__summary {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem 1.25rem;
		max-width: 42rem;
		margin: 0;
		padding: 1rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.case-hero__summary div {
		display: grid;
		gap: 0.25rem;
		align-content: start;
	}

	.case-hero__summary dt {
		color: var(--color-muted);
		font-size: var(--font-size-muted);
	}

	.case-hero__summary dd {
		margin: 0;
		line-height: 1.5;
	}

	.case-hero__summary-result {
		grid-column: 1 / -1;
	}

	.case-hero__media {
		width: 100%;
	}

	.case-hero p {
		margin: 0;
	}

	.case-hero__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.case-hero__resume {
		color: var(--color-muted);
		font-size: var(--font-size-muted);
	}

	.case-hero__demo {
		display: grid;
		gap: 0.6rem;
		padding: 1rem 1.05rem;
		scroll-margin-top: 4.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.case-hero__demo p {
		margin: 0;
	}

	@media (max-width: 36rem) {
		.case-hero__summary { grid-template-columns: 1fr; }
		.case-hero__summary-result { grid-column: auto; }
	}
</style>
