---
import { site } from '../data/site';
import { updatedCaption } from '../lib/contact';
---

<div class="site-footer">
	<p class="muted">{updatedCaption(site.updatedAt)}</p>
</div>

<style>
	.site-footer {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.75rem;
		padding: 2rem 1.25rem 2.5rem;
	}

	.site-footer p {
		margin: 0;
		max-width: var(--lede-max);
	}
</style>
